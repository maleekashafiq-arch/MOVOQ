# Copy to .env.local and fill in. Everything here is shipped to the browser, so keep secrets out.

# Where the .NET API lives. Leave blank to use the Vite dev proxy (recommended in development).
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:5014

# Firebase web app config. Admins sign in with the same Firebase project as the mobile app; access is
# granted by the API only if the signed-in email exists in the admin_users table.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=movoq-cc5b8
VITE_FIREBASE_APP_ID=

# Development escape hatch. When true the app sends the API's local test header instead of a Firebase
# token, so you can work on screens without signing in. Never enable this for a deployed build.
VITE_ALLOW_DEV_SIGN_IN=true
